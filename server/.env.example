# Mongo connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/student_dashboard

# Secret for signing JWTs — use a long random string in production
JWT_SECRET=change-me

# Set to "production" on your host. Controls cookie secure/sameSite flags.
NODE_ENV=development

PORT=5000

# Comma-separated frontend origins allowed by CORS, no trailing slash
CORS_ORIGINS=https://your-frontend.url

# Used only by scripts/seedAdmin.js
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_PHONE=+91 0000000000
